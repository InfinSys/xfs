&quot;color: light-dark(rgb(51, 153, 255), rgb(51, 153, 255));&quot;&gt;Network Drive Path&lt;/font&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ~ Windows:&lt;/div&gt;&lt;div&gt;\\###.###.#.###\InfinSys\projects\SWE\vc&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 102, 102), rgb(255, 102, 102));&quot;&gt;&amp;lt;===&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Via IP address&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;\\INFINITY-IDX01\InfinSys\projects\SWE\vc&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 102, 102), rgb(255, 102, 102));&quot;&gt;&amp;lt;===&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Windows Uniform Naming Convention&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ~ Linux&lt;/div&gt;&lt;div&gt;ssh://###.###.#.###/infinsys/projects/SWE/vc/&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 102, 102), rgb(255, 102, 102));&quot;&gt;&amp;lt;===&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Via IP address [&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;variable protocol&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;]&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;smb://infinity-idx01/infinsys/projects/SWE/vc&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 102, 102), rgb(255, 102, 102));&quot;&gt;&amp;lt;===&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Windows Uniform Naming Convention&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;" vertex="1">
