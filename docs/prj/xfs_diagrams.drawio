        </mxCell>
        <mxCell id="CaNCh2WZdoQSmwADeQU--0" value="enum FileEncoding : uint8_t {&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_8,&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // UTF-8&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_16,&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;// UTF-16 (native endianness)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_16_LE,&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;// UTF-16 (little endian)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_16_BE,&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;// UTF-16 (big endian)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_32,&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;// UTF-32 (native endianness)&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_32_LE,&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;// UTF-32 (little endian)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_32_BE,&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;// UTF-32 (big endian)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Lucida Console;" vertex="1" parent="AAKn3JwIwb8s-OrhhNjA-1">
          <mxGeometry x="-3860" y="-1097" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="CaNCh2WZdoQSmwADeQU--1" value="enum xfs::Path::Encoding : uint8_t {&lt;div&gt;&amp;nbsp; &amp;nbsp; NATIVE,&amp;nbsp; &amp;nbsp; // Native path encoding&lt;br&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_8,&amp;nbsp; &amp;nbsp; &amp;nbsp;// UTF-8 encoding&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UTF_16&amp;nbsp; &amp;nbsp; &amp;nbsp;// UTF-16 encoding&lt;/div&gt;&lt;div&gt;&lt;div&gt;};&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Lucida Console;" vertex="1" parent="AAKn3JwIwb8s-OrhhNjA-1">
